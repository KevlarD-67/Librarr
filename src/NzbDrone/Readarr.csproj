<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\NzbDrone.Host\Readarr.ico</ApplicationIcon>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <!--
    System.Resources.Extensions used to be referenced here to satisfy
    GenerateResourceUsePreserializedResources above. The .NET 10 SDK provides
    it in-box, so the explicit reference now trips NU1510 ("will not be
    pruned") which TreatWarningsAsErrors turns into a build failure.

    This one only appears when building the net10.0-windows TFM, so a
    Linux-only CI never sees it — it was found by actually building on
    Windows. See the release workflow's windows job.
  -->
  <ItemGroup>
    <ProjectReference Include="..\NzbDrone.Host\Readarr.Host.csproj" />
    <ProjectReference Include="..\NzbDrone.Windows\Readarr.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
