 "key": "/books/OL39696987M", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2022-09-18T23:02:18.916089"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-17T21:31:42.493503"}}, {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL25342A"}], "isbn_13": ["9798428346091"], "languages": [{"key": "/languages/ger"}], "pagination": "260", "publish_date": "2022", "publishers": ["Independently Published"], "source_records": ["bwb:9798428346091"], "title": "Frankenstein Oder der Moderne Prometheus (illustriert)", "weight": "0.400", "full_title": "Frankenstein Oder der Moderne Prometheus (illustriert)", "works": [{"key": "/works/OL450063W"}], "key": "/books/OL39724942M", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2022-09-19T03:52:07.900052"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-17T21:31:42.493503"}}, {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL25342A"}], "isbn_13": ["9798836573461"], "languages": [{"key": "/languages/ger"}], "pagination": "260", "publish_date": "2022", "publishers": ["Independently Published"], "source_records": ["bwb:9798836573461"], "title": "Frankenstein Oder der Moderne Prometheus (illustriert)", "weight": "0.400", "full_title": "Frankenstein Oder der Moderne Prometheus (illustriert)", "works": [{"key": "/works/OL450063W"}], "key": "/books/OL39751668M", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2022-09-19T08:14:52.382077"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-17T21:31:42.493503"}}]}