ecords": ["bwb:9781283474832"], "title": "Pride and Prejudice", "subtitle": "the Wild and Wanton Edition", "full_title": "Pride and Prejudice the Wild and Wanton Edition", "works": [{"key": "/works/OL66554W"}], "key": "/books/OL51318418M", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2024-03-17T02:44:35.215572"}, "last_modified": {"type": "/type/datetime", "value": "2024-04-22T19:44:23.814581"}}, {"works": [{"key": "/works/OL66554W"}], "title": "Stolz und Vorurteil", "publishers": ["Anaconda"], "publish_date": "September 30, 2018", "key": "/books/OL50552339M", "type": {"key": "/type/edition"}, "identifiers": {}, "covers": [14568556], "isbn_13": ["9783730606490"], "isbn_10": ["3730606492"], "classifications": {}, "contributors": [{"role": "Illustrator", "name": "Hugh Thomson"}], "languages": [{"key": "/languages/ger"}], "description": {"type": "/type/text", "value": "Geschenkausgabe: mit Illustrationen, Leseb\u00e4ndchen und hochwertigem Einband.\r\n\r\nIm England des ausgehenden 18. Jahrhunderts steht die junge und sch\u00f6ne Elisabeth Bennet vor einer gro\u00dfen Lebensentscheidung: der Wahl eines geeigneten Heiratskandidaten. Ihr allzu stolzes Wesen jedoch vernebelt ihr ein ums andere Mal den Blick, bis sie nach vielen Verwicklungen schlie\u00dflich doch die Liebe ihres Lebens findet. Jane Austens Roman 'Stolz und Vorurteil' kr\u00f6nt die erste Schaffensphase der englischen Autorin und sichert ihr einen Platz in den Annalen der Weltliteratur. Diese Ausgabe ist reich illustriert mit den ber\u00fchmten Illustrationen von Hugh Thomson."}, "physical_format": "gebundene Ausgabe", "number_of_pages": 448, "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2024-01-19T10:14:25.657143"}, "last_modified": {"type": "/type/datetime", "value": "2024-01-19T10:15:24.820441"}}, {"type": {"key": "/type/edition"}, "publish_date": "1962", "publish_country": "nyu", "languages": [{"key": "/languages/eng"}], "ti