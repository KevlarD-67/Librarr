rs": ["Hodder & Stoughton"], "source_records": ["bwb:9780450054808"], "subjects": ["Fiction, horror"], "title": "Stand", "full_title": "Stand", "works": [{"key": "/works/OL81618W"}], "key": "/books/OL53233289M", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2024-08-17T05:15:06.031395"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-19T11:28:10.046355"}}, {"type": {"key": "/type/edition"}, "title": "Mah\u015fer", "authors": [{"key": "/authors/OL7829293A"}], "publish_date": "Nov 01, 2015", "source_records": ["amazon:9754058997"], "publishers": ["Altin Kitaplar"], "isbn_10": ["9754058997"], "isbn_13": ["9789754058994"], "physical_format": "paperback", "full_title": "Mah\u015fer", "covers": [12279667], "works": [{"key": "/works/OL81618W"}], "key": "/books/OL35438404M", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2021-11-01T10:19:52.637380"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-19T07:18:10.468104"}}, {"identifiers": {"librarything": ["1242461"], "goodreads": ["6453719"]}, "title": "Le Fleau", "publish_date": "1991", "publishers": ["Editions Jean-Claude Lattes"], "physical_format": "Paperback", "isbn_13": ["9782709610209"], "languages": [{"key": "/languages/fre"}], "isbn_10": ["2709610205"], "oclc_numbers": ["27417158"], "type": {"key": "/type/edition"}, "local_id": ["urn:bwbsku:KR-023-218"], "source_records": ["promise:bwb_daily_pallets_2022-07-04", "ia:lefleau0000unse", "amazon:2709610205"], "ocaid": "lefleau0000unse", "key": "/books/OL8913573M", "works": [{"key": "/works/OL81618W"}], "covers": [14657541, 13352004], "number_of_pages": 1183, "latest_revision": 11, "revision": 11, "created": {"type": "/type/datetime", "value": "2008-04-30T09:38:13.731961"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-19T05:31:19.429043"}}, {"type": {"key": "/type/edition"}, "title": "Fleau ****** epouvante", "authors": [{"key": "/authors/OL19981A"}], "publish_date": "Feb 26, 2001", "source_records": ["amazon:2277223263"], "number_of_pages": 576, "publishers": ["J'AI LU"], "isbn_10": ["2277223263"], "isbn_13": ["9782277223269"], "physical_format": "paperback", "notes": {"type": "/type/text", "value": "Source title: Fleau ****** epouvante (Le) (IMAGINAIRE)"}, "works": [{"key": "/works/OL81618W"}], "key": "/books/OL39220665M", "latest_revision": 5, "revision": 5, "created": {"type": "/type/datetime", "value": "2022-08-10T10:36:19.925060"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-19T05:31:19.429043"}}, {"identifiers": {"amazon": ["B084FSYTHQ"], "better_world_books": ["BWBM51980239"]}, "title": "The Stand", "type": {"key": "/type/edition"}, "local_id": ["urn:bwbsku:O8-CXE-838"], "source_records": ["promise:bwb_daily_pallets_2022-09-07"], "key": "/books/OL42897509M", "works": [{"key": "/works/OL81618W"}], "classifications": {}, "edition_name": "Library Edition", "languages": [{"key": "/languages/eng"}], "publishers": ["Doubleday Books"], "publish_places": ["Garden City, NY"], "publish_date": "1978", "physical_format": "Hardcover", "latest_revision": 6, "revision": 6, "created": {"type": "/type/datetime", "value": "2022-12-04T11:57:15.593386"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-28T22:25:52.151182"}}, {"publishers": ["Suma"], "source_records": ["amazon:8581050549"], "title": "A Dan\u00e7a da Morte", "notes": "Source title: Danca da Morte (Em Portugues do Brasil)", "covers": [10452820], "physical_format": "paperback", "publish_date": "2013", "key": "/books/OL30378091M", "authors": [{"key": "/authors/OL7829287A"}], "works": [{"key": "/works/OL81618W"}], "type": {"key": "/type/edition"}, "identifiers": {}, "isbn_10": ["8581050549"], "isbn_13": ["9788581050546"], "weight": "1.38 kilos", "publish_places": ["Brazil"], "copyright_date": "2013", "edition_name": "1\u00aa", "languages": [{"key": "/languages/por"}], "translation_of": "The Stand", "translated_from": [{"key": "/languages/eng"}], "description": {"type": "/type/text", "value": "Ap\u00f3s um erro de computa\u00e7\u00e3o no Departamento de Defesa, um v\u00edrus \u00e9 liberado, dando origem \u00e0 doen\u00e7a que ficar\u00e1 conhecida como Capit\u00e3o Viajante, ou \u201csupergripe\u201d. N\u00e3o demora muito para que um milh\u00e3o de contatos casuais formem uma cadeia de morte, e \u00e9 assim que o mundo como o conhecemos acaba. O que surge no lugar \u00e9 um mundo \u00e1rido, sem institui\u00e7\u00f5es e esvaziado de 99% da popula\u00e7\u00e3o. Um mundo onde sobreviventes em p\u00e2nico escolhem seus lados \u2015 ou s\u00e3o escolhidos. Os bons se apoiam nos ombros fr\u00e1geis de M\u00e3e Abigail, com seus cento e oito anos de idade, enquanto todo o mal \u00e9 incorporado por um indiv\u00edduo de poderes indiz\u00edveis: Randall Flagg, o homem escuro.\r\n\r\nCom sua complexidade moral, precis\u00e3o de ritmo e brilhante constru\u00e7\u00e3o de personagens, A dan\u00e7a da morte tem um lugar garantido entre os cl\u00e1ssicos da literatura contempor\u00e2nea."}, "number_of_pages": 1248, "latest_revision": 4, "revision": 4, "created": {"type": "/type/datetime", "value": "2020-09-20T20:56:10.481098"}, "last_modified": {"type": "/type/datetime", "value": "2025-10-05T19:23:37.497396"}}, {"description": {"type": "/type/text", "value": "Epic Terror to Chill Your Dreams\r\nJune 16, 1985. That is when the horror began - the evil that started in a laboratory and took over America. Those who died quickly were the lucky ones. For the scattered survivors, wandering through a country turned into a gigantic graveyard, life has become a nightmare struggle. They escaped death, but now something even more terrifying is waiting to claim them - the most fiendish force ever to seek all humanity as slaves and victims. A strange, faceless, clairvoyant figure that is reaching for their very souls... \r\n--back cover"}, "title": "The Stand", "authors": [{"key": "/authors/OL19981A"}], "publish_date": "1987?", "publishers": ["New American Library"], "first_sentence": "Hapscomb's Texaco sat on Number 93 just north of Arnette, a pissant four-street burg about 110 miles from Houston.", "type": {"key": "/type/edition"}, "isbn_10": ["0451160959"], "isbn_13": ["9780451160959"], "ocaid": "stand00step_0", "publish_places": ["New York"], "copyright_date": "1978", "edition_name": "1st Signet printing (44)", "languages": [{"key": "/languages/eng"}], "physical_format": "mass market paperback", "covers": [14651766], "source_records": ["amazon:0451160959"], "key": "/books/OL7572744M", "works": [{"key": "/works/OL81618W"}], "latest_revision": 18, "revision": 18, "created": {"type": "/type/datetime", "value": "2008-04-29T13:35:46.876380"}, "last_modified": {"type": "/type/datetime", "value": "2026-03-12T14:09:32.125648"}}, {"description": {"type": "/type/text", "value": "Imagine America devastated by a vast killer plague that moves from coast to coast. Imagine the countryside destroyed and great cities decimated as the entire population desperately and futilely seeks safety. Imagine then an even greater evil rising to threaten the survivors---and a last embattled group of men and women coming together to make a last stand against it.\r\n\r\nHere is Stephen King's most terrifying vision, his most stirring story, his most magnificent cast of characters, his ultimate tale of good versus evil, his supreme triumph, published in its complete uncut version.\r\n--back cover"}, "title": "The Stand", "authors": [{"key": "/authors/OL19981A"}], "publish_date": "1994?", "publishers": ["Signet"], "first_sentence": "Hapscomb's Texaco sat on Number 93 just north of Arnette, a pissant four-street burg about 110 miles from Houston.", "type": {"key": "/type/edition"}, "isbn_10": ["0451179285"], "isbn_13": ["9780451179289"], "ocaid": "stand00step", "publish_places": ["New York"], "copyright_date": "1990", "edition_name": "Movie Tie-In Edition; 1st Signet printing (7)", "languages": [{"key": "/languages/eng"}], "physical_format": "mass market paperback", "covers": [14651565], "source_records": ["amazon:0451179285"], "key": "/books/OL7573468M", "number_of_pages": 1168, "works": [{"key": "/works/OL81618W"}], "latest_revision": 21, "revision": 21, "created": {"type": "/type/datetime", "value": "2008-04-29T13:35:46.876380"}, "last_modified": {"type": "/type/datetime", "value": "2026-01-06T18:55:54.540584"}}, {"works": [{"key": "/works/OL81618W"}], "title": "The Stand", "publishers": ["Signet"], "publish_date": "1991", "key": "/books/OL53037020M", "type": {"key": "/type/edition"}, "identifiers": {}, "isbn_10": ["0451179285"], "ocaid": "standcompleteunc0000king", "classifications": {}, "languages": [{"key": "/languages/eng"}], "covers": [14653998], "latest_revision": 4, "revision": 4, "created": {"type": "/type/datetime", "value": "2024-08-07T10:14:36.459319"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-15T21:30:57.629446"}}, {"type": {"key": "/type/edition"}, "title": "Apocalipsis. El libro en el que se basa la serie The Stand", "authors": [{"key": "/authors/OL7829295A"}, {"key": "/authors/OL7940836A"}], "publish_date": "Jan 21, 2021", "source_records": ["amazon:8466357238"], "number_of_pages": 1584, "publishers": ["Debolsillo", "DEBOLSILLO"], "isbn_10": ["8466357238"], "isbn_13": ["9788466357234"], "physical_format": "mass market paperback", "covers": [14092066], "works": [{"key": "/works/OL81618W"}], "key": "/books/OL47483481M", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2023-04-17T12:41:42.835126"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-15T21:30:57.629446"}}, {"type": {"key": "/type/edition"}, "title": "Apocalipsis. El libro en el que se basa la serie The Stand", "authors": [{"key": "/authors/OL7829295A"}, {"key": "/authors/OL7940836A"}], "publish_date": "Jan 21, 2021", "source_records": ["amazon:8466357238"], "number_of_pages": 1584, "publishers": ["Debolsillo", "DEBOLSILLO"], "i