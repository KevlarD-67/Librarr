{"links": {"self": "/works/OL81618W/editions.json?limit=20", "work": "/works/OL81618W", "next": "/works/OL81618W/editions.json?limit=20&offset=20"}, "size": 85, "entries": [{"works": [{"key": "/works/OL81618W"}], "title": "L'ombra dello scorpione", "publishers": ["Bompiani"], "publish_date": "1994", "key": "/books/OL61439825M", "type": {"key": "/type/edition"}, "identifiers": {}, "covers": [15200584], "isbn_13": ["9788845212178"], "languages": [{"key": "/languages/ita"}], "translation_of": "The Stand", "translated_from": [{"key": "/languages/eng"}], "description": {"type": "/type/text", "value": "L'errore di un computer, l'incoscienza di pochi uomini e si scatena la fine del mondo. Il morbo sfuggito a un segretissimo laboratorio semina morte e terrore. Il novantanove per cento della popolazione della terra non sopravvive all'apocalittica epidemia e per i pochi scampati c'\u00e8 una guerra ancora tutta da combattere, una lotta eterna e fatale tra chi ha deciso di seguire il Bene e appoggiarsi alle fragili spalle di Mother Abagail, la veggente ultracentenaria, e chi invece ha scelto di calcare le orme di Randall, il Senza Volto, il Male, il Signore delle Tenebre."}, "physical_format": "Paperback", "number_of_pages": 929, "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2026-03-23T17:00:13.937029"}, "last_modified": {"type": "/type/datetime", "value": "2026-03-23T17:01:06.909150"}}, {"works": [{"key": "/works/OL81618W"}], "title": "The Stand", "publishers": ["NEL"], "publish_date": "1991", "key": "/books/OL61173791M", "type": {"key": "/type/edition"}, "identifiers": {}, "isbn_13": ["9780450537370"], "isbn_10": ["0450537374"], "subtitle": "For the first time the complete and uncut edition", "publish_places": ["Great Britain"], "copyright_date": "1978", "description": {"type": "/type/text", "value": "First came the days of the plague... Then came the dreams... Dark dreams that warned of the coming of the dark man. The apostate of death, his worn-down boot heels tramping the night roads. The warlord of the charnel house and Prince of Evil. His time is at hand. His empire grows in the west and the Apocalypse looms. \r\n\r\nTHE STAND first appeared in 1978 and has since been regarded by many as Stephen King's greatest book. However, a considerable amount of the original work had been cut from the published version. Only now has this material been restored, with a new foreword by the author in THE STAND: For the First Time. Complete and Uncut."}, "physical_format": "paperback", "number_of_pages": 1424, "covers": [15164295], "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2026-01-24T20:32:36.276011"}, "last_modified": {"type": "/type/datetime", "value": "2026-01-24T20:40:18.683871"}}, {"works": [{"key": "/works/OL81618W"}], "title": "The Stand", "publishers": ["Doubleday"], "publish_date": "1978", "key": "/books/OL58142869M", "type": {"key": "/type/edition"}, "publish_places": ["USA"], "copyright_date": "1978", "edition_name": "The Stand", "covers": [14914282], "ocaid": "bwb_S0-CBZ-193", "source_records": ["ia:bwb_S0-CBZ-193"], "languages": [{"key": "/languages/eng"}], "number_of_pages": 846, "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2025-03-12T20:59:29.070326"}, "last_modified": {"type": "/type/datetime", "value": "2025-04-27T19:16:56.470645"}}, {"works": [{"key": "/works/OL81618W"}], "title": "The Stand", "publishers": ["Doubleday"], "publish_date": "2020", "key": "/books/OL54120973M", "type": {"key": "/type/edition"}, "identifiers": {}, "covers": [14817826], "classifications": {}, "edition_name": "Barnes & Noble Collectible Edition", "physical_format": "Hardcover", "isbn_13": ["9780525616719"], "oclc_numbers": ["1455291809"], "dewey_decimal_class": ["813.54"], "latest_revision": 4, "revision": 4, "created": {"type": "/type/datetime", "value": "2024-09-18T22:08:48.915469"}, "last_modified": {"type": "/type/datetime", "va