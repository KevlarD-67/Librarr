thor": {"key": "/authors/OL26320A"}}], "key": "/works/OL29423030W", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2022-11-19T12:04:02.850424"}, "last_modified": {"type": "/type/datetime", "value": "2026-02-10T23:24:41.191862"}}, {"title": "Sagan om konungens \u00e5terkomst", "authors": [{"author": {"key": "/authors/OL26320A"}, "type": {"key": "/type/author_role"}}], "key": "/works/OL44810554W", "type": {"key": "/type/work"}, "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2026-01-25T12:41:10.719702"}, "last_modified": {"type": "/type/datetime", "value": "2026-01-25T12:41:10.719702"}}, {"type": {"key": "/type/work"}, "title": "Se\u00f1or de Los Anillos", "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}], "key": "/works/OL40852464W", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2024-09-27T20:10:30.148222"}, "last_modified": {"type": "/type/datetime", "value": "2025-11-23T22:54:22.038889"}}, {"type": {"key": "/type/work"}, "title": "Feanorian alphabet", "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}], "key": "/works/OL44334456W", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2025-11-04T08:23:03.186862"}, "last_modified": {"type": "/type/datetime", "value": "2025-11-04T08:23:03.186862"}}, {"type": {"key": "/type/work"}, "title": "\u05d1\u05e8\u05df \u05d5\u05dc\u05d5\u05ea\u05d9\u05df", "subjects": ["Good and evil", "Fiction", "Quests", "Elves", "Middle Earth (Imaginary place)"], "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}, {"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL2623360A"}}, {"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL14022388A"}}], "key": "/works/OL44315520W", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2025-10-30T17:23:00.842196"}, "last_modified": {"type": "/type/datetime", "value": "2025-10-30T17:23:00.842196"}}, {"type": {"key": "/type/work"}, "title": "A\u1e25a\u1e7fat ha-\u1e6daba\u02bbat", "subjects": ["Middle Earth (Imaginary place)", "Fiction", "English Fantasy fiction"], "subject_people": ["Frodo Baggins"], "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}, {"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL12115382A"}}, {"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL145209A"}}, {"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL14022388A"}}], "key": "/works/OL43516294W", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2025-06-15T21:12:15.789107"}, "last_modified": {"type": "/type/datetime", "value": "2025-10-29T20:25:30.378136"}}, {"type": {"key": "/type/work"}, "title": "Sipurim she-lo nishlemu", "subjects": ["Middle Earth (Imaginary place)", "Fiction", "English Fantasy fiction"], "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}, {"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL14991321A"}}, {"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL14022388A"}}], "key": "/works/OL44027951W", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2025-09-08T14:11:39.887212"}, "last_modified": {"type": "/type/datetime", "value": "2025-09-08T14:11:39.887212"}}, {"title": "O Senhor dos An\u00e9is", "authors": [{"author": {"key": "/authors/OL26320A"}, "type": {"key": "/type/author_role"}}], "key": "/works/OL44024416W", "type": {"key": "/type/work"}, "description": {"type": "/type/text", "value": "Em O Retorno do Rei, acompanhamos o mago Gandalf e o hobbit Pippin em sua visita \u00e0 majestosa cidade de Minas Tirith, que j\u00e1 foi o principal baluarte dos Homens contra a amea\u00e7a de Sauron, mas que est\u00e1 prestes a sucumbir diante da for\u00e7a avassaladora do Senhor Sombrio. Outros membros da Sociedade do Anel se juntam a Aragorn, herdeiro da longa linhagem dos reis de Minas Tirith, na tentativa de evitar que a antiga capital do reino de Gondor seja destru\u00edda.    \r\n\r\n Nas fronteiras de Mordor, Sam resgata Frodo, e os dois hobbits partem para o \u00faltimo est\u00e1gio de sua jornada rumo ao Monte da Perdi\u00e7\u00e3o, uma jornada que testar\u00e1 os limites do corpo e da mente dos pequenos her\u00f3is.  O livro inclui ainda numerosos ap\u00eandices, nos quais Tolkien explora detalhes da hist\u00f3ria, das l\u00ednguas, dos alfabetos e at\u00e9 dos calend\u00e1rios de seu mundo ficcional."}, "subtitle": "O Retorno do Rei", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2025-09-07T13:44:39.014942"}, "last_modified": {"type": "/type/datetime", "value": "2025-09-07T13:48:01.453742"}}, {"title": "O Senhor dos An\u00e9is", "authors": [{"author": {"key": "/authors/OL26320A"}, "type": {"key": "/type/author_role"}}], "key": "/works/OL44024379W", "type": {"key": "/type/work"}, "description": {"type": "/type/text", "value": "Um ataque-surpresa p\u00f4s fim \u00e0 jornada conjunta da Sociedade do Anel. De um lado, o trio formado pelo elfo Legolas, pelo an\u00e3o Gimli e por Aragorn, herdeiro da realeza dos Homens, tenta resgatar os jovens hobbits Merry e Pippin, capturados por guerreiros-\u00f3rquicos. A busca pelos companheiros perdidos levar\u00e1 os tr\u00eas a confrontar os cavaleiros do reino de Rohan e o mago renegado Saruman, que tamb\u00e9m deseja o Um Anel para si. Enquanto isso, do outro lado das montanhas, Frodo e Sam buscam uma maneira de entrar em Mordor e chegar at\u00e9 a montanha onde o Anel foi forjado, \u00fanico lugar onde \u00e9 poss\u00edvel destru\u00ed-lo. Para isso, acabam recebendo a ajuda de seu mais improv\u00e1vel aliado: Gollum, a criatura que chegou a ter o Anel sob seu poder durante centenas de anos e que ainda \u00e9 devorada, em corpo e alma, pelo desejo de voltar a possu\u00ed-lo."}, "subtitle": "As Duas Torres", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2025-09-07T13:35:40.261206"}, "last_modified": {"type": "/type/datetime", "value": "2025-09-07T13:39:28.734596"}}, {"type": {"key": "/type/work"}, "title": "O Senhor dos An\u00e9is - A Sociedade do Anel", "key": "/works/OL39483030W", "authors": [{"author": {"key": "/authors/OL26320A"}, "type": {"key": "/type/author_role"}}], "description": {"type": "/type/text", "value": "A Sociedade do Anel come\u00e7a no Condado, a regi\u00e3o rural do oeste da Terra-m\u00e9dia onde vivem os diminutos e pacatos hobbits. Bilbo Bolseiro, um dos raros aventureiros desse povo, cujas perip\u00e9cias foram contadas em O Hobbit, resolve ir embora do Condado e deixa sua consider\u00e1vel heran\u00e7a nas m\u00e3os de seu jovem parente Frodo.     O mais importante legado de Bilbo \u00e9 o anel m\u00e1gico que costumava usar para se tornar invis\u00edvel. No entanto, o mago Gandalf, companheiro de aventuras do velho hobbit, revela a Frodo que o objeto \u00e9 o Um Anel, a raiz do poder demon\u00edaco de Sauron, o Senhor Sombrio, que deseja escravizar todos os povos da Terra-m\u00e9dia. A \u00fanica maneira de eliminar a amea\u00e7a de Sauron \u00e9 destruir o Um Anel nas entranhas da pr\u00f3pria montanha de fogo onde foi forjado. A revela\u00e7\u00e3o faz com que Frodo e seus companheiros hobbits Sam, Merry e Pippin deixem a seguran\u00e7a do Condado e iniciem uma perigosa jornada rumo ao leste. Ao lado de representantes dos outros Povos Livres que resistem ao Senhor Sombrio, eles formam a Sociedade do Anel."}, "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2024-09-07T01:26:47.513851"}, "last_modified": {"type": "/type/datetime", "value": "2025-09-07T13:30:31.389832"}}, {"type": {"key": "/type/work"}, "title": "The return of the king", "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}], "key": "/works/OL44008642W", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2025-09-03T18:13:28.485605"}, "last_modified": {"type": "/type/datetime", "value": "2025-09-03T18:13:28.485605"}}, {"type": {"key": "/type/work"}, "title": "The hobbit, or There and back again", "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}], "key": "/works/OL43904252W", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2025-08-17T06:27:54.778657"}, "last_modified": {"type": "/type/datetime", "value": "2025-08-17T06:27:54.778657"}}, {"type": {"key": "/type/work"}, "title": "Farmer Giles of Ham", "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}], "key": "/works/OL43865496W", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2025-08-11T22:06:39.486758"}, "last_modified": {"type": "/type/datetime", "value": "2025-08-11T22:06:39.486758"}}, {"type": {"key": "/type/work"}, "title": "Hobbit", "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}], "key": "/works/OL41567001W", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2024-10-03T12:01:29.217053"}, "last_modified": {"type": "/type/datetime", "value": "2025-07-24T18:02:29.002729"}}, {"type": {"key": "/type/work"}, "title": "Fellowship of the Ring", "authors": [{"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL14456887A"}}, {"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL26320A"}}, {"type": {"key": "/type/author_role"}, "author": {"key": "/authors/OL14456888A"}}], "key": "/works/OL40334275W", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2024-09-23T20:08:05.985466"}, "last_modified": {"type": "/type/datetime", "value": "2025-07-2